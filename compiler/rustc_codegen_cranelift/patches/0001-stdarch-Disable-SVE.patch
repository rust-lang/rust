From e90274ba5bc4bee03a24e8c134ea223497c3a46b Mon Sep 17 00:00:00 2001
From: Cathal Mullan <contact@cathal.dev>
Date: Sat, 13 Jun 2026 20:32:02 +0100
Subject: [PATCH] Disable SVE

Cranelift doesn't support scalable vectors.
---
 crates/core_arch/src/aarch64/mod.rs  | 8 ++++----
 crates/intrinsic-test/src/arm/mod.rs | 1 +
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/crates/core_arch/src/aarch64/mod.rs b/crates/core_arch/src/aarch64/mod.rs
index 34fa5c8..a870e31 100644
--- a/crates/core_arch/src/aarch64/mod.rs
+++ b/crates/core_arch/src/aarch64/mod.rs
@@ -19,16 +19,16 @@ mod neon;
 pub use self::neon::*;
 
 // The rest of `core_arch::aarch64` is available on `arm64ec` but SVE is not supported on `arm64ec`.
-#[cfg(any(all(target_arch = "aarch64", target_endian = "little"), doc))]
+#[cfg(all(not(test), any(all(target_arch = "aarch64", target_endian = "little"), doc)))]
 mod sve;
-#[cfg(any(all(target_arch = "aarch64", target_endian = "little"), doc))]
+#[cfg(all(not(test), any(all(target_arch = "aarch64", target_endian = "little"), doc)))]
 #[unstable(feature = "stdarch_aarch64_sve", issue = "145052")]
 pub use self::sve::*;
 
 // The rest of `core_arch::aarch64` is available on `arm64ec` but SVE is not supported on `arm64ec`.
-#[cfg(any(all(target_arch = "aarch64", target_endian = "little"), doc))]
+#[cfg(all(not(test), any(all(target_arch = "aarch64", target_endian = "little"), doc)))]
 mod sve2;
-#[cfg(any(all(target_arch = "aarch64", target_endian = "little"), doc))]
+#[cfg(all(not(test), any(all(target_arch = "aarch64", target_endian = "little"), doc)))]
 #[unstable(feature = "stdarch_aarch64_sve", issue = "145052")]
 pub use self::sve2::*;
 
diff --git a/crates/intrinsic-test/src/arm/mod.rs b/crates/intrinsic-test/src/arm/mod.rs
index 9c2d0f3..3825f41 100644
--- a/crates/intrinsic-test/src/arm/mod.rs
+++ b/crates/intrinsic-test/src/arm/mod.rs
@@ -66,6 +66,7 @@ impl SupportedArchitecture for Arm {
 
         let intrinsics = intrinsics
             .into_iter()
+            .filter(|i| i.extension != "SVE" && i.extension != "SVE2")
             // Skip intrinsics that don't return a value.
             .filter(|i| i.results.kind() != TypeKind::Void)
             // Skip bfloat intrinsics - not currently supported
-- 
2.54.0

