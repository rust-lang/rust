---
source: src/bootstrap/src/core/builder/cli_paths/tests.rs
expression: dist
---
[Dist] dist::Docs
    targets: [aarch64-unknown-linux-gnu]
    - Set({rust-docs})
[Dist] dist::JsonDocs
    targets: [aarch64-unknown-linux-gnu]
    - Set({rust-docs-json})
[Dist] dist::Mingw
    targets: [aarch64-unknown-linux-gnu]
    - Set({rust-mingw})
[Dist] dist::Rustc
    targets: [x86_64-unknown-linux-gnu]
    - Set({rustc})
[Dist] dist::Std
    targets: [aarch64-unknown-linux-gnu]
    - Set({rust-std})
[Dist] dist::RustcDev
    targets: [x86_64-unknown-linux-gnu]
    - Set({rustc-dev})
[Dist] dist::Src
    targets: [x86_64-unknown-linux-gnu]
    - Set({rust-src})
[Dist] dist::RustDev
    targets: [x86_64-unknown-linux-gnu]
    - Set({rust-dev})
[Dist] dist::PlainSourceTarball
    targets: [x86_64-unknown-linux-gnu]
    - Set({rustc-src})
[Dist] dist::PlainSourceTarballGpl
    targets: [x86_64-unknown-linux-gnu]
    - Set({rustc-src-gpl})
[Dist] dist::ReproducibleArtifacts
    targets: [x86_64-unknown-linux-gnu]
    - Set({reproducible-artifacts})
