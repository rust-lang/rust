//@ check-pass
//@ run-rustfix

#![no_std]
#![crate_type = "lib"]
#![allow(unused_unsafe)]
#![allow(dead_code)]

pub unsafe fn should_lint(a: usize) {
    let _ptr: *const u8 = unsafe { core::ptr::with_exposed_provenance::<u8>(a) };
    //~^ WARN transmuting an integer to a pointer
    let _ptr: *mut u8 = unsafe { core::ptr::with_exposed_provenance_mut::<u8>(a) };
    //~^ WARN transmuting an integer to a pointer
}
