// MIR for `branch` 0 dataflow

fn branch(_1: bool) -> u32 {
    let mut _0: u32;
    let mut _2: u32;

    bb0: {
        // early: [_1]
        // late: [_1, _2]
        _2 = const 1_u32;
        // early: [_1, _2]
        // late: [_2]
        switchInt(copy _1) -> [1: bb1, otherwise: bb2];
    }

    bb1: {
        // early: [_2]
        // late: [_0]
        _0 = move _2;
        // early: [_0]
        // late: []
        return;
    }

    bb2: {
        // early: []
        // late: [_0]
        _0 = const 0_u32;
        // early: [_0]
        // late: []
        return;
    }
}
