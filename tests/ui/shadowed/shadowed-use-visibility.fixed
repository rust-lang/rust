//@ run-rustfix

// Import suggestions should bypass private module aliases in favor of accessible functions.

#![allow(unused_imports, dead_code)]

mod foo {
    pub fn f() {}

    use crate::foo as bar;
    pub use self::f as bar;
}

mod bar {
    use foo::f as g; //~ ERROR module import `bar` is private

    use crate::foo as f;
    pub use crate::foo::*;
}

use bar::f; //~ ERROR module import `f` is private
fn main() {}
