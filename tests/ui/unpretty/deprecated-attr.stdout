#[attr = Deprecated {deprecation: Deprecation {since: NonStandard("1.2.3"),
note: here's why this is deprecated#0}, is_inner: false}]
struct SinceAndNote;

#[attr = Deprecated {deprecation: Deprecation {since: NonStandard("1.2.3"),
note: here's why this is deprecated#0}, is_inner: false}]
