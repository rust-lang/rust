#![feature(ergonomic_clones)]
#![warn(rust_2021_compatibility)]
#![allow(incomplete_features)]

use std::clone::UseCloned;

#[derive(Debug, Clone)]
struct Foo(i32);
impl Drop for Foo {
    fn drop(&mut self) {
        println!("{:?} dropped", self.0);
    }
}

impl UseCloned for Foo {}

fn main() {
    let a = (Foo(0), Foo(1));
    let f = || {
        let _ = &a;
        //~^ HELP: add a dummy
        //~| WARNING: drop order
        let x = a.0.use;
        println!("{:?}", x);
    };
    f();
}
