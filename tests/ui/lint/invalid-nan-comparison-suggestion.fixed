//@ check-pass
//@ run-rustfix

#![feature(f16, f128)]

fn main() {
    let x = 5f16;
    let _ = x.is_nan();
    //~^ WARN incorrect NaN comparison
    let _ = !x.is_nan();
    //~^ WARN incorrect NaN comparison

    let x = 5f32;
    let _ = x.is_nan();
    //~^ WARN incorrect NaN comparison
    let _ = !x.is_nan();
    //~^ WARN incorrect NaN comparison

    let x = 5f64;
    let _ = x.is_nan();
    //~^ WARN incorrect NaN comparison
    let _ = !x.is_nan();
    //~^ WARN incorrect NaN comparison

    let x = 5f128;
    let _ = x.is_nan();
    //~^ WARN incorrect NaN comparison
    let _ = !x.is_nan();
    //~^ WARN incorrect NaN comparison

    let b = &2.3f32;
    if !b.is_nan() {}
    //~^ WARN incorrect NaN comparison

    let b = &2.3f32;
    if !b.is_nan() {}
    //~^ WARN incorrect NaN comparison

    let _ =
        !b.is_nan();

    // Issue #164143: an unsuffixed float is constrained by the `NAN` operand.
    // Suggesting `.is_nan()` drops that constraint and does not compile.
    let b = &3.3;
    if !f64::is_nan(*b) {}
    //~^ WARN incorrect NaN comparison

    let mut m = &3.3;
    if !f64::is_nan(*m) {
        //~^ WARN incorrect NaN comparison
        m = &1.0;
    }
    let _ = m;

    let _ = f64::is_nan(3.3);
    //~^ WARN incorrect NaN comparison

    let _ = !f64::is_nan(3.3);
    //~^ WARN incorrect NaN comparison

    let suffixed = 3.3f64;
    let copied = suffixed;
    let _ = !copied.is_nan();
    //~^ WARN incorrect NaN comparison

    let ascribed: f64 = 3.3;
    let _ = !ascribed.is_nan();
    //~^ WARN incorrect NaN comparison

    parameter(1.0);
    parameter_ref(&1.0);
    let _ = |x: f64| !x.is_nan(); //~ WARN incorrect NaN comparison

    #[allow(unused_macros)]
    macro_rules! nan { () => { f32::NAN }; }
    macro_rules! number { () => { 5f32 }; }

    let _ = number!().is_nan();
    //~^ WARN incorrect NaN comparison
    let _ = !number!().is_nan();
    //~^ WARN incorrect NaN comparison
}

fn parameter(x: f64) {
    let _ = x.is_nan();
    //~^ WARN incorrect NaN comparison
}

fn parameter_ref(x: &f32) {
    if !x.is_nan() {}
    //~^ WARN incorrect NaN comparison
}
